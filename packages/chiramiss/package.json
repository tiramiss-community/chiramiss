{
	"name": "@tiramiss-community/chiramiss",
	"version": "0.0.0",
	"description": "summaly-compatible URL summary library",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "https://github.com/tiramiss-community/chiramiss.git",
		"directory": "packages/chiramiss"
	},
	"bugs": "https://github.com/tiramiss-community/chiramiss/issues",
	"type": "module",
	"main": "./built/index.js",
	"types": "./built/index.d.ts",
	"exports": {
		".": {
			"types": "./built/index.d.ts",
			"import": "./built/index.js",
			"default": "./built/index.js"
		},
		"./package.json": "./package.json"
	},
	"files": [
		"built",
		"LICENSE"
	],
	"engines": {
		"node": "^22.22.2 || ^24.17.0 || >=26.4.0"
	},
	"publishConfig": {
		"access": "public",
		"provenance": true
	},
	"scripts": {
		"build": "tsdown",
		"test": "vitest run",
		"typecheck": "tsc --noEmit -p tsconfig.json",
		"typecheck:compat": "tsc -p tsconfig.compat.json && node scripts/check-no-fastify.mjs"
	},
	"devDependencies": {
		"@types/node": "26.6.6",
		"fastify": "5.12.8",
		"tsdown": "0.23.5",
		"typescript": "7.0.2",
		"vitest": "5.1.0"
	},
	"dependencies": {
		"chardet": "^2.2.0",
		"cheerio": "^1.2.0",
		"html-entities": "^2.6.0",
		"htmlparser2": "^12.0.0",
		"ipaddr.js": "^2.5.0"
	}
}
